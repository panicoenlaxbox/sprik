{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/app/**/*",
    "src/renderer/settings/**/*",
    "src/renderer/history/**/*",
    "src/renderer/overlay/**/*",
    "src/renderer/worker/**/*",
    "src/renderer/shared/**/*",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/renderer/shared/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  }
}
